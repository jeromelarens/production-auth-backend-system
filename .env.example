# ==============================================================================
# Production Authentication Platform - Environment Variables Template
# Copy this file to .env and configure the appropriate values for your environment.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/auth_db?sslmode=prefer"

# Redis Configuration (Optional / Session Caching)
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=false

# JWT Secret Keys & Token Expiry
JWT_ACCESS_SECRET="your_jwt_access_secret_min_16_chars_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_16_chars_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie Configuration
COOKIE_SECRET="your_cookie_signing_secret_key"
COOKIE_DOMAIN=""
COOKIE_SECURE=false

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Account Security & Lockout Policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15

# Email Service Provider (console | mock | smtp | sendgrid)
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@authservice.local"
